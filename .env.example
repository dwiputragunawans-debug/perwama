APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Alamat proxy/CDN yang dipercaya (mis. `*` di belakang Cloudflare). Kosongkan
# Bila server diakses langsung; lihat bootstrap/app.php.
# TRUSTED_PROXIES="*"

# Masa retensi (hari) data pribadi pendaftar yang ditolak sebelum dianonimkan.
# Lihat `php artisan membership:purge-rejected` dan config/perwama.php.
MEMBERSHIP_RETENTION_DAYS=180

# Akun administrator panel Filament (dipakai seeder AdminUserSeeder).
# Admin tambahan didaftarkan pada config/perwama.php.
ADMIN_NAME="Administrator PERWAMA INA"
ADMIN_EMAIL=admin@perwama-ina.or.id
# WAJIB diisi (minimal 12 karakter, tidak mudah ditebak). Tidak ada kata
# sandi bawaan: pada environment selain local/testing, seeder berhenti bila
# variabel ini kosong atau lemah.
ADMIN_PASSWORD=
# ADMIN_PHONE=0812-0000-0000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_perwama
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie sesi hanya dikirim lewat HTTPS. Bila APP_URL memakai https:// nilainya
# otomatis menjadi true (lihat config/session.php); set false hanya untuk uji
# lokal lewat http.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
